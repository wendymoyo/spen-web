webdriver {
    autodownload=false
    driver = edge
}

headless.mode=true

chrome.switches="--disable-extensions;--ignore-certificate-errors;
                    --user-agent=New User Agent"

drivers {
    windows {
        webdriver.chrome.driver=src/test/resources/drivers/windows/chromedriver.exe
        webdriver.edge.driver=src/test/resources/drivers/windows/msedgedriver.exe
        webdriver.gecko.driver=src/test/resources/drivers/windows/geckodriver.exe
        webdriver.opera.driver=src/test/resources/drivers/windows/operadriver.exe
    }
    mac {
        webdriver.chrome.driver=src/test/resources/drivers/mac/chromedriver
        webdriver.gecko.driver=src/test/resources/drivers/mac/geckodriver
        webdriver.opera.driver=src/test/resources/drivers/mac/operadriver
    }
    linux {

    }
}

serenity {
    report {
       accessibility = true
    }
}

environments {
    default {
        webdriver.base.url = "[url]"
    }
    dev {
        webdriver.base.url = "[url]"
    }
    test {
        webdriver.base.url = "[url]"
    }
    prod {
        webdriver.base.url = "[url]"
    }
    salesforceUAT {
        webdriver.base.url = "[url]"
    }
}

webdriver {
  driver = remote
  remote.url = "[url]"
}
browserstack.user="[username]"
browserstack.key="[key]"

